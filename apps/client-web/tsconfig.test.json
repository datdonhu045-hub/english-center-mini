{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/client-web.test.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@english-center/contracts": ["../../packages/contracts/src/index.ts"],
      "@english-center/utils": ["../../packages/utils/src/index.ts"],
      "@english-center/api-client": ["../../packages/api-client/src/index.ts"],
      "@english-center/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "tests/**/*.ts"]
}
